      "link": null,
      "locked": false,
      "text": "model User {\n  id            String          @id @default(uuid())\n  nome          String\n  email         String          @unique\n  cargo         String\n  area          String\n  password      String\n  createdAt     DateTime        @default(now())\n\n  conversations Conversations[]\n\n  // Empresas criadas pelo usuário (dono)\n  ownedEmpresas Empresas[]      @relation(\"EmpresaOwner\")\n\n  // Compartilhamentos recebidos\n  sharedWithMe  EmpresaShare[]  @relation(\"SharedWithUser\")\n\n  // Compartilhamentos concedidos a outros\n  sharedByMe    EmpresaShare[]  @relation(\"SharedByUser\")\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "model User {\n  id            String          @id @default(uuid())\n  nome          String\n  email         String          @unique\n  cargo         String\n  area          String\n  password      String\n  createdAt     DateTime        @default(now())\n\n  conversations Conversations[]\n\n  // Empresas criadas pelo usuário (dono)\n  ownedEmpresas Empresas[]      @relation(\"EmpresaOwner\")\n\n  // Compartilhamentos recebidos\n  sharedWithMe  EmpresaShare[]  @relation(\"SharedWithUser\")\n\n  // Compartilhamentos concedidos a outros\n  sharedByMe    EmpresaShare[]  @relation(\"SharedByUser\")\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
