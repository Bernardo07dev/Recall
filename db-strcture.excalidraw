      "text": "model Empresas {\n  id            String          @id @default(uuid())\n  nome          String\n  content       String\n  json          Json?\n  context       String?\n  resume        String?\n  industry      String\n  files         String[]        @default([])\n  logo          String?\n  relation      String?\n  createdAt     DateTime        @default(now())\n  status        String          @default(\"processing\")\n\n  isPublic      Boolean         @default(false)\n\n  ownerId       String\n\n  shares        EmpresaShare[]\n  conversations Conversations[]\n}",
