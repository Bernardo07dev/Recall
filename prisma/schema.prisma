generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  cargo     String
  area      String
  password  String
  createdAt DateTime @default(now())

  conversations Conversations[]
}

model Conversations{
  id        String  @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Empresas{
  id        String  @id @default(uuid())
  nome      String
  content   String
  json      Json?
  context   String?
  industry  String
  files     String[] @default([])
  relation  String?
}