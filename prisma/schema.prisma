generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  cargo     String
  area      String
  password  String
  createdAt DateTime @default(now())

  conversations Conversations[]
}

model Empresas{
  id        String  @id @default(uuid())
  nome      String
  content   String
  json      Json?
  context   String?
  resume    String?
  industry  String
  files     String[] @default([])
  logo      String?
  relation  String?
  createdAt DateTime @default(now())
  status    String   @default("processing")
  conversations Conversations[]
}

model Conversations{
  id        String  @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  userId    String
  companyId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Empresas? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  Messages[]
}

enum Role {
  human
  AI
  Tool
}

model Messages{
  id             String @id @default(uuid())
  context        String
  role           Role
  toolMetadata   Json?
  createdAt      DateTime @default(now())
  conversationId String?
  conversations  Conversations? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}