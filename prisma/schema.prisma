generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  cargo     String
  area      String
  password  String
  createdAt DateTime @default(now())

  conversations Conversations[]

  ownedEmpresas Empresas[]      @relation("EmpresaOwner")
  sharedWithMe  EmpresaShare[]  @relation("SharedWithUser")
  sharedByMe    EmpresaShare[]  @relation("SharedByUser")
}

model Empresas {
  id        String   @id @default(uuid())
  nome      String
  content   String
  json      Json?
  context   String?
  resume    String?
  industry  String
  files     String[] @default([])
  logo      String?
  relation  String?
  createdAt DateTime @default(now())
  status    String   @default("processing")

  isPublic  Boolean  @default(false)

  ownerId   String
  owner     User     @relation("EmpresaOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  shares        EmpresaShare[]
  conversations Conversations[]
}

model EmpresaShare {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())

  empresaId  String
  empresa    Empresas @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation("SharedWithUser", fields: [userId], references: [id], onDelete: Cascade)

  sharedById String
  sharedBy   User     @relation("SharedByUser", fields: [sharedById], references: [id], onDelete: Cascade)

  permission String   @default("viewer")

  @@unique([empresaId, userId])
}

model Conversations{
  id        String  @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  userId    String
  companyId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Empresas? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  Messages[]
  tools     ConversationTool[]
}

model ConversationTool {
  id             String        @id @default(uuid())
  title          String
  type           String
  createdAt      DateTime      @default(now())
  
  conversationId String
  conversation   Conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum Role {
  human
  AI
  Tool
}

model Messages{
  id             String @id @default(uuid())
  context        String
  role           Role
  toolMetadata   Json?
  createdAt      DateTime @default(now())
  conversationId String?
  conversations  Conversations? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}